<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>jQuery Series</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" >

    <style>
        .c1{
            background-color: #2196F3;
            color:white;
        }

        .c2{
            font-size:60px;
        }
    </style>

</head>
<body>

        <h1>Welcome to jQuery Series Day 3</h1>
        <h1>Day 3</h1>

        <input type="button" value="Submit" id="btn">
        <input type="button" value="Remove Class" id="btn1">

        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
         <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            $(document).ready(function(){
                $("#btn").click(function(){
                    $("h1").addClass("jumbotron text-center text-white bg-danger");
                }); 

                 $("#btn1").click(function(){
                    $("h1").removeClass(" text-center text-white bg-danger");  //yaha pe agar removeClass ke ander kuch nhi pass kiya to pura class remove ho jayega, jo class hatana h wo class likh do
                }); 
            })
        </script>
    
</body>
</html>


-----------ToggleClass-----------------

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>jQuery Series</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" >

</head>
<body>

        <h1>Welcome to jQuery Series Day 3</h1>
        <h1>Day 3</h1>

        <input type="button" value="Submit" id="btn">

        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
         <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            $(document).ready(function(){
                $("#btn").click(function(){
                    $("h1").toggleClass("jumbotron text-center text-white bg-danger");
                }); 
            })
        </script>
    
</body>
</html>
