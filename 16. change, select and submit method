change() method in jquery

The change event occurs when the value of an element has been changed(only working on <input>,<textarea> and <select> elements ).
Yaha pe bina button click kiye hi jo tum select wale field me jo select karoge wo data dikh jayega


----------------Program 1------------------------
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>



    <select id="list">
        <option value="-1">Select fruit</option>
        <option value="Mango">Mango</option>
        <option value="Banana">Banana</option>
        <option value="Grapes">Grapes</option>
        <option value="Litchi">Litchi</option>
        <option value="Papaya">Papaya</option>
    </select>

    <h1></h1>


    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>
        $(document).ready(function(){
            $("#list").change(function(){
                let a=$("#list").val();

                if(a==="-1"){
                    alert("please select the fruit");
                }else{
                    $("h1").text("You have selected "+a);
                }
            })
        })
    </script>

</body>
</html>


