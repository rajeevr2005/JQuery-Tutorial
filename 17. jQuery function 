6. wrap() :- jaise hmlog ek paragraph likh diye, phir chahte h ki wo ek div me aa jaye to hmlog wrap method lagaynge aur us wrap method me div parameter pass karenge 

<!DOCTYPE html> 

<html lang="en"> 

<head> 

<meta charset="UTF-8"> 

<meta name="viewport" content="width=device-width, initial-scale=1.0"> 

<title>jQuery series</title> 

<style> 

#box{ 

height:200px;
 width:200px; 
border:2px solid ridge; background-color:aqua ; 

} 

</style> 

</head> 

<body> 

<h1 id="output"></h1> 

<h1 id="para">This is Paragraph</h1> 

<input type="button" value="Wrap" id="btn"> 

<input type="button" value="unWrap" id="btn2"> 

<input type="button" value="WrapAll" id="btn3"> 

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script> 

<script> 

$(document).ready(function(){ 

$("#btn").click(function(){ 

$("#para").wrap("<div id='box'></div>") 

}) 

$("#btn2").click(function(){ $("#para").unwrap(); 

}) 

}) 

</script> 

</body>

 </html> 

