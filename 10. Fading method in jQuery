//fadeTo()  method

The jQuery fadeTo() method allows fading to a given opacity(value between 0 and 1)
fadeTo(speed,)


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>jQuery series</title>
</head>
<body>

    <h1 >Welcome to jQuery Series</h1>

    <div id="box" style="border:1px solid black;background-color: aqua;height:100px;width:100px;margin-bottom:20px;">
        Div
    </div>

    <input type="button" value="Fade Toggle" id="btn">



    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>
        $(document).ready(function(){
            $("#btn").click(function(){
                $("#box").fadeTo(4000,0.5);     //speed opacity(kitna visible hona chahiye) callback function 
            })
        })
    </script>
    
</body>
</html>
