5. ------------- on -----------------

    on event kab lagate h jab hmlog ko ek hi element pe multiple event lagana ho jaise mouseenter,mouseup, mousedown, etc;

    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mouse Event</title>
</head>
<body>


   

    <h1>Welcome to jquery session</h1>



    <input type="button" value="Click Me" id="Btn">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>

        $(document).ready(function(){
            $("h1").on({
                mouseenter:function(){
                        $("h1").css("background-color","red")
                },
                mouseleave:function(){
                    $("h1").css("background-color","aqua");
                },
                click:function(){
                    $("h1").css("background-color","green")
                }
            })
        })
        
    </script>
</body>
</html>
